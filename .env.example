# ==============================================================================
# SportsPulse — Production Environment Configuration Template
# ==============================================================================
# This template documents all environment variables used by the SportsPulse
# production application. Copy this file to '.env' on your VPS and configure.
# NEVER commit the real '.env' file or production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PORT
# ------------------------------------------------------------------------------
# Purpose: Listening TCP port for the SportsPulse Node.js application server.
# Required: Optional (defaults to 3000 if unset).
# Safe placeholder: 3000
# Production recommendation: Set to 3000 (or custom internal port). Keep bound
# internally behind Nginx/Caddy; do not expose this port directly to the internet.
PORT=3000

# ------------------------------------------------------------------------------
# 2. NODE_ENV
# ------------------------------------------------------------------------------
# Purpose: Runtime environment indicator for Node.js and Express. Enables
# production performance optimizations and secure cookie behavior.
# Required: Required in production.
# Safe placeholder: production
# Production recommendation: Set to "production" on your live VPS.
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. JWT_SECRET
# ------------------------------------------------------------------------------
# Purpose: Cryptographic secret key used by jsonwebtoken to sign and verify
# user authentication tokens and session cookies.
# Required: Required in production.
# Safe placeholder: CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING
# Production recommendation: MUST be generated using a cryptographically secure
# random generator (e.g., run: openssl rand -hex 32). Never reuse development keys.
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_64_CHAR_STRING

# ------------------------------------------------------------------------------
# 4. STORAGE_PATH
# ------------------------------------------------------------------------------
# Purpose: Filesystem directory path for storing user-uploaded media assets
# (tournament logos, team badges, sponsor overlays, and player headshots).
# Required: Optional (defaults to "uploads" in the application root).
# Safe placeholder: uploads
# Production recommendation: Use "uploads" or an absolute path such as
# "/var/www/sportspulse/uploads" with proper read/write permissions for www-data.
STORAGE_PATH=uploads

# ------------------------------------------------------------------------------
# 5. APP_URL
# ------------------------------------------------------------------------------
# Purpose: Public canonical URL where SportsPulse is hosted behind Nginx/Caddy.
# Required: Optional (application defaults to relative routing).
# Safe placeholder: https://YOUR_DOMAIN
# Production recommendation: Set to your public domain (e.g., https://sports.example.com).
APP_URL=https://YOUR_DOMAIN

# ------------------------------------------------------------------------------
# 6. GEMINI_API_KEY
# ------------------------------------------------------------------------------
# Purpose: Google Gemini API key for optional generative AI features.
# Required: Optional (core tournament, scoring, and broadcast engines do not require it).
# Safe placeholder: ""
# Production recommendation: Leave blank or set only if AI features are enabled.
# GEMINI_API_KEY=
